---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../utils/categories';
import FormField from '../../components/FormField.astro';
import PageHeader from '../../components/PageHeader.astro';

export async function getStaticPaths() {
  const documents = await getCollection('documents');
  return documents.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const { title, categories, fields, groups = [], calculator } = doc.data;
const category = categories[0]; // pierwsza kategoria jest główna (okruszki)

const ungrouped = fields.filter((f) => !f.group);
const grouped = groups.map((g) => ({ ...g, fields: fields.filter((f) => f.group === g.id) }));
---

<Layout title={title}>
  <PageHeader
    title={title}
    crumbs={[
      { label: category, href: `/categories/${slugify(category)}` },
      { label: title },
    ]}
  />

    <div class="flex flex-col xl:flex-row gap-8 items-start">

      <form
        id="document-form"
        data-calculator={calculator}
        class="card bg-base-100 shadow-xl p-6 border border-base-200 w-full xl:w-max xl:min-w-64 xl:sticky xl:top-8 shrink-0 space-y-4 print:hidden"
      >        
      <h2 class="text-2xl font-bold">Dane dokumentu</h2>
        {ungrouped.map((f) => <FormField field={f} />)}

        {grouped.map((g) => (
          <fieldset class="border border-base-300 rounded-box p-4">
            <legend class="px-2 font-semibold">{g.title}</legend>
            <p class="text-sm text-base-content/70 max-w-xs mb-3">{g.description}</p>
            <div class="flex flex-col gap-4">
              {g.fields.map((f) => <FormField field={f} />)}
            </div>
          </fieldset>
        ))}

        <button type="button" id="print-btn" class="btn btn-primary w-full">Drukuj / Pobierz PDF</button>
      </form>

      <div class="flex-1 min-w-0 w-full">
        <div id="page-frame" class="mx-auto w-full max-w-[1100px]">
          <!-- sizer rezerwuje wysokość po przeskalowaniu -->
          <div id="page-sizer">
            <div id="document-preview" class="bg-white text-black shadow-2xl border border-base-200">
              <article class="prose prose-slate max-w-none leading-relaxed text-gray-900">
                <Content />
              </article>
            </div>
          </div>
        </div>
      </div>
    </div>

    <dialog id="missing-dialog" class="modal print:hidden">
    <div class="modal-box">
      <h3 class="text-lg font-bold">Nie wszystkie pola są wypełnione</h3>
      <p class="py-2 text-sm">Brakuje:</p>
      <ul id="missing-list" class="list-disc pl-5 text-sm space-y-1"></ul>
      <p class="pt-4 text-sm text-base-content/70">
        Możesz uzupełnić dane albo wydrukować dokument z pustymi miejscami do wypełnienia ręcznie.
      </p>
      <div class="modal-action flex-wrap">
        <button type="button" id="missing-fill" class="btn btn-primary">Uzupełnij dane</button>
        <button type="button" id="missing-print" class="btn btn-outline">Drukuj z pustymi miejscami</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button aria-label="Zamknij">zamknij</button></form>
  </dialog>
</Layout>

<script>
  import { declineName, guessGender, type Case, type Gender } from '../../utils/inflect';
  import { calculators } from '../../utils/calculators';

  const form = document.getElementById('document-form') as HTMLFormElement;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;

  // wartość pola: radio → wybrana opcja, checkbox → 'yes' / 'no', reszta → tekst
  function valueOf(name: string): string {
    const el = form.elements.namedItem(name);
    if (!el) return '';
    if (el instanceof RadioNodeList) return el.value;
    const input = el as HTMLInputElement;
    return input.type === 'checkbox' ? (input.checked ? 'yes' : 'no') : input.value;
  }

  function setValue(name: string, value: string) {
    const el = form.elements.namedItem(name);
    if (!el) return;
    if (el instanceof RadioNodeList) {
      el.forEach((node) => {
        const radio = node as HTMLInputElement;
        if (radio.type === 'radio') radio.checked = radio.value === value;
      });
    } else {
      (el as HTMLInputElement).value = value;
    }
  }

  // domyślne wartości: data-default="today" (lokalna data)
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  form.querySelectorAll<HTMLInputElement>('input[data-default="today"]').forEach((input) => {
    if (!input.value) input.value = today;
  });

  // płeć wybrana ręcznie albo odgadnięta z imienia; null, gdy jeszcze nic nie wiadomo
  function genderOf(id: string): Gender | null {
    const chosen = field(`${id}__gender`)?.value as Gender | '' | undefined;
    if (chosen) return chosen;
    const name = field(id)?.value.trim();
    return name ? guessGender(name) : null;
  }

  // zapamiętaj tekst z md jako wartość domyślną
  document.querySelectorAll<HTMLElement>('[data-field], [data-honorific], [data-gender]').forEach((el) => {
    el.dataset.fallback = el.textContent ?? '';
  });
  document.querySelectorAll<HTMLElement>('[data-list]').forEach((ul) => {
    ul.dataset.fallback = ul.querySelector('li')?.textContent ?? '';
  });

  // kalkulator dokumentu (frontmatter: calculator)
  const calculator = form.dataset.calculator ? calculators[form.dataset.calculator] : undefined;

  function recalc() {
    if (!calculator) return;
    const result = calculator(valueOf);
    for (const [name, value] of Object.entries(result.set ?? {})) setValue(name, value);
    for (const [name, text] of Object.entries(result.output ?? {})) {
      const el = form.querySelector<HTMLElement>(`[data-output="${name}"]`);
      if (el) el.textContent = text;
    }
  }

  // pola i fragmenty widoczne tylko przy określonym wyborze: "pole=a,b" lub "pole=a;inne=b" (wszystkie warunki)
  function applyConditions() {
    document.querySelectorAll<HTMLElement>('[data-show-when]').forEach((el) => {
      const show = el.dataset.showWhen!.split(';').every((condition) => {
        const [name, values] = condition.split('=');
        return values.split(',').includes(valueOf(name));
      });
      el.classList.toggle('hidden', !show);
      el.querySelectorAll<HTMLInputElement>('input, select').forEach((input) => {
        input.disabled = !show;
      });
    });
  }

  // podgląd na żywo
  function update() {
    recalc();
    applyConditions();

    document.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
      const id = el.dataset.field!;
      const input = field(id);
      if (!input) return;

      let value = input.type === 'date' && input.value
        ? new Date(input.value + 'T00:00:00').toLocaleDateString('pl-PL')
        : input.value.trim();

      const c = el.dataset.case as Case | undefined;
      if (value && c) value = declineName(value, genderOf(id) ?? guessGender(value), c);

      el.textContent = value || el.dataset.fallback || '';
    });

    // starszy zapis: panią/pana
    document.querySelectorAll<HTMLElement>('[data-honorific]').forEach((el) => {
      const gender = genderOf(el.dataset.honorific!);
      el.textContent = gender ? (gender === 'f' ? 'panią' : 'pana') : el.dataset.fallback || '';
    });

    // tekst zależny od płci: data-gender + data-m / data-f
    document.querySelectorAll<HTMLElement>('[data-gender]').forEach((el) => {
      const gender = genderOf(el.dataset.gender!);
      const text = gender === 'f' ? el.dataset.f : gender === 'm' ? el.dataset.m : undefined;
      el.textContent = text ?? el.dataset.fallback ?? '';
    });

    // tekst zależny od przełącznika: data-choice + atrybut o nazwie wybranej wartości
    document.querySelectorAll<HTMLElement>('[data-choice]').forEach((el) => {
      const value = valueOf(el.dataset.choice!);
      const text = value ? el.dataset[value] : undefined;
      if (text) el.textContent = text;
    });

    // listy: jedna pozycja na wpisaną wartość
    document.querySelectorAll<HTMLElement>('[data-list]').forEach((ul) => {
      const values = [...form.querySelectorAll<HTMLInputElement>(`input[name="${ul.dataset.list}"]`)]
        .map((input) => input.value.trim())
        .filter(Boolean);
      const items = values.length ? values : [ul.dataset.fallback ?? ''];
      ul.replaceChildren(
        ...items.map((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          if (!values.length) li.dataset.empty = 'true';
          return li;
        })
      );
    });
  }

  form.addEventListener('input', update);

  // ---- powtarzalne pola (lista) ----
  function syncList(list: HTMLElement) {
    const count = list.querySelectorAll('[data-list-row]').length;
    list.querySelector<HTMLButtonElement>('[data-list-add]')!.disabled = count >= Number(list.dataset.max ?? 8);
  }

  form.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const add = target.closest<HTMLElement>('[data-list-add]');
    if (add) {
      const list = add.closest<HTMLElement>('[data-list-field]')!;
      const rows = list.querySelector<HTMLElement>('[data-list-rows]')!;
      if (rows.children.length >= Number(list.dataset.max ?? 8)) return;

      const row = rows.firstElementChild!.cloneNode(true) as HTMLElement;
      const input = row.querySelector('input')!;
      input.value = '';
      row.querySelector('[data-list-remove]')?.classList.remove('hidden');
      rows.append(row);
      input.focus();
      syncList(list);
      return;
    }

    const remove = target.closest('[data-list-remove]');
    if (remove) {
      const list = remove.closest<HTMLElement>('[data-list-field]')!;
      remove.closest('[data-list-row]')?.remove();
      syncList(list);
      update();
    }
  });

  // ---- druk z kontrolą braków ----
  const dialog = document.getElementById('missing-dialog') as HTMLDialogElement;
  const missingList = document.getElementById('missing-list') as HTMLUListElement;

  function missingFields() {
    const selector = 'input:not([type="radio"]):not([type="checkbox"]):not([data-optional]):not(:disabled)';
    return [...form.querySelectorAll<HTMLInputElement>(selector)]
      .filter((input) => {
        if (input.value.trim()) return false;
        if ('listItem' in input.dataset) {
          // lista: brakuje tylko wtedy, gdy puste są wszystkie jej pozycje
          const same = [...form.querySelectorAll<HTMLInputElement>(`input[name="${input.name}"]`)];
          return input === same[0] && same.every((i) => !i.value.trim());
        }
        return true;
      })
      .map((input) => {
        const group = input.closest('fieldset')?.querySelector('legend')?.textContent?.trim();
        const name =
          input.closest('label, [data-list-field]')?.querySelector('.label-text')?.textContent?.trim() ?? input.name;
        return { input, label: group ? `${group}: ${name}` : name };
      });
  }

  document.getElementById('print-btn')?.addEventListener('click', () => {
    const missing = missingFields();
    if (!missing.length) {
      window.print();
      return;
    }
    missingList.replaceChildren(
      ...missing.map((m) => {
        const li = document.createElement('li');
        li.textContent = m.label;
        return li;
      })
    );
    dialog.showModal();
  });

  document.getElementById('missing-fill')?.addEventListener('click', () => {
    dialog.close();
    missingFields()[0]?.input.focus();
  });

  document.getElementById('missing-print')?.addEventListener('click', () => {
    dialog.close();
    window.print();
  });

  // przed wydrukiem puste miejsca zamieniamy na linie do wpisania ręcznie
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
      const input = field(el.dataset.field!);
      if (input && !input.value.trim()) {
        el.textContent = '\u00A0';
        el.classList.add('print-blank');
      }
    });

    document.querySelectorAll<HTMLElement>('[data-honorific]').forEach((el) => {
      if (!genderOf(el.dataset.honorific!)) el.textContent = 'panią/pana';
    });

    // nieustalona płeć: obie formy do ręcznego skreślenia
    document.querySelectorAll<HTMLElement>('[data-gender]').forEach((el) => {
      if (!genderOf(el.dataset.gender!)) el.textContent = el.dataset.print ?? `${el.dataset.f}/${el.dataset.m}`;
    });

    // pusta lista: jedna linia do wpisania
    document.querySelectorAll<HTMLElement>('li[data-empty]').forEach((li) => {
      const blank = document.createElement('span');
      blank.className = 'print-blank';
      blank.textContent = '\u00A0';
      li.replaceChildren(blank);
    });
  });

  window.addEventListener('afterprint', () => {
    document.querySelectorAll('.print-blank').forEach((el) => el.classList.remove('print-blank'));
    update();
  });

  // ---- kartka A4 dopasowana do szerokości kolumny ----
  const frame = document.getElementById('page-frame') as HTMLElement;
  const sizer = document.getElementById('page-sizer') as HTMLElement;
  const page = document.getElementById('document-preview') as HTMLElement;

  const fit = () => {
    const scale = frame.clientWidth / page.offsetWidth;
    page.style.transform = `scale(${scale})`;
    sizer.style.height = `${page.offsetHeight * scale}px`;
  };

  const refit = () => requestAnimationFrame(fit);
  new ResizeObserver(refit).observe(frame);
  new ResizeObserver(refit).observe(page);
  document.fonts.ready.then(fit);
  fit();

  // ---- podgląd wysuwany z prawej (telefon/tablet) ----
  const pane = document.getElementById('preview-pane') as HTMLElement;
  const backdrop = document.getElementById('preview-backdrop') as HTMLElement;
  const desktop = window.matchMedia('(min-width: 1024px)');

  function setPreview(open: boolean) {
    pane.dataset.open = String(open);
    backdrop.dataset.open = String(open);
    document.body.classList.toggle('overflow-hidden', open);
  }

  document.getElementById('open-preview')?.addEventListener('click', () => setPreview(true));
  document.getElementById('close-preview')?.addEventListener('click', () => setPreview(false));
  backdrop.addEventListener('click', () => setPreview(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setPreview(false));
  desktop.addEventListener('change', () => setPreview(false));

  // gesty: przesunięcie w lewo otwiera, w prawo zamyka
  let startX = 0;
  let startY = 0;

  document.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
  }, { passive: true });

  document.addEventListener('touchend', (e) => {
    if (desktop.matches || dialog.open) return;
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 2) return;

    const open = pane.dataset.open === 'true';
    if (open && dx > 0) setPreview(false);
    if (!open && dx < 0) setPreview(true);
  }, { passive: true });

  // stan początkowy podglądu (dzisiejsza data, wyliczenia, ukryte pola warunkowe)
  update();
</script>