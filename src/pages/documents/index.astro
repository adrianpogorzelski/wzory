---
import Layout from '../../layouts/Layout.astro';
import DocumentRow from '../../components/DocumentRow.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';

const documents = await getCollection('documents');
---

<Layout title="Wszystkie dokumenty - Wzory Dokumentów">
  <PageHeader title="Wszystkie dokumenty" crumbs={[{ label: 'Wszystkie dokumenty' }]} />
  <ul class="list bg-base-100 rounded-box shadow-md">
    {documents.map((doc) => <DocumentRow doc={doc} />)}
  </ul>
</Layout>