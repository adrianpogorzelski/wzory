---
import Layout from '../../layouts/Layout.astro';
import DocumentRow from '../../components/DocumentRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { docCategories, getCategories } from '../../utils/categories';

export async function getStaticPaths() {
  const documents = await getCollection('documents');
  return getCategories(documents).map((c) => ({
    params: { category: c.slug },
    props: { name: c.name },
  }));
}

const { category } = Astro.params;
const { name } = Astro.props;

const all = await getCollection('documents');
const documents = all.filter((d) => docCategories(d).some((c) => c.slug === category));
---

<Layout title={`${name} - Wzory Dokumentów`}>
  <PageHeader title={name} crumbs={[{ label: name }]} />
  <ul class="list bg-base-100 rounded-box shadow-md">
    {documents.map((doc) => <DocumentRow doc={doc} exclude={category} />)}
  </ul>
</Layout>