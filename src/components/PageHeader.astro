---
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  crumbs: Crumb[];
}

const { title, crumbs } = Astro.props;
---

<div class="mb-6 print:hidden">
  <Breadcrumbs items={crumbs} />
  <h1 class="text-xl sm:text-2xl font-bold">{title}</h1>
</div>