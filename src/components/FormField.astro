---
import type { CollectionEntry } from 'astro:content';

type Field = CollectionEntry<'documents'>['data']['fields'][number];

interface Props {
  field: Field;
}

const { field } = Astro.props;
---

<div class="flex flex-col gap-3">
  <label class="form-control">
    <span class="label-text whitespace-nowrap">{field.label}</span>
    <input
      type={field.type === 'date' ? 'date' : 'text'}
      name={field.id}
      placeholder={field.placeholder}
      class="input input-bordered w-full"
    />
  </label>

  {field.type === 'person' && (
    <label class="form-control">
      <span class="label-text text-xs text-base-content/70">Płeć (do odmiany)</span>
      <select name={`${field.id}__gender`} class="select select-bordered select-sm w-full">
        <option value="">Wykryj automatycznie</option>
        <option value="f">Kobieta</option>
        <option value="m">Mężczyzna</option>
      </select>
    </label>
  )}
</div>