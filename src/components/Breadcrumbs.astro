---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs text-sm py-0 mb-3 overflow-x-clip print:hidden" aria-label="Breadcrumb">  
  <ul>
    <li class="shrink-0">
      <a href="/" aria-label="Strona główna" class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 sm:hidden" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <span class="hidden sm:inline">Strona główna</span>
      </a>
    </li>
    {items.map((item, i) => {
      const last = i === items.length - 1;
      return (
        <li class={last ? 'min-w-0' : 'shrink-0'}>
          {item.href
            ? <a href={item.href} class:list={['block', last && 'truncate']}>{item.label}</a>
            : <span class="block truncate">{item.label}</span>}
        </li>
      );
    })}
  </ul>
</nav>