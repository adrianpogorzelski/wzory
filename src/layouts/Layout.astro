---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro'; 

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;

const contentWidth = wide ? 'max-w-[1600px]' : 'max-w-4xl';
const navWidth = wide ? 'max-w-[1800px]' : 'max-w-5xl';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-base-200 print:bg-white">
    <Navbar containerClass={navWidth} />

    <div class:list={['flex-1 w-full mx-auto px-4 py-8 print:p-0 print:max-w-none', contentWidth]}>
      <slot />
    </div>

    <footer class="footer footer-center p-4 bg-base-100 text-sm print:hidden">
      © 2026 Wzory Dokumentów. Szybko, prosto i legalnie.
    </footer>
  </body>
</html>