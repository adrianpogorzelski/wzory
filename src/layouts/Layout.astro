---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Wzory Dokumentów i Pism – Generator PDF", 
  description = "Darmowe wzory umów, pism urzędowych, reklamacji i wniosków z opcją generowania PDF." 
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content">

    <!-- Wspólny nagłówek z komponentem navbar DaisyUI -->
    <header class="navbar bg-base-200 shadow-md px-6">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl font-bold">📄 Wzory Dokumentów Online</a>
      </div>
      <div class="flex-none">
        <!-- Tutaj w przyszłości możesz wrzucić np. linki nawigacji lub wyszukiwarkę w nagłówku -->
      </div>
    </header>

    <!-- Główna zawartość dynamiczna (flex-grow wypycha stopkę na sam dół) -->
    <main class="flex-grow w-full max-w-4xl mx-auto p-6">
      <slot />
    </main>

    <!-- Wspólna stopka DaisyUI -->
    <footer class="footer footer-center bg-base-300 text-base-content p-4 mt-auto">
      <aside>
        <p>&copy; 2026 Wzory Dokumentów. Szybko, prosto i legalnie.</p>
      </aside>
    </footer>

  </body>
</html>