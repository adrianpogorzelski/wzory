---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { CONTAINER } from '../utils/layout';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh flex flex-col bg-base-200 print:bg-white">
    <Navbar />

    <main class:list={['flex-1 py-4 sm:py-8 print:max-w-none print:p-0', CONTAINER]}>
      <slot />
    </main>

    <footer class="bg-base-100 border-t border-base-300 py-3 text-xs text-base-content/70 print:hidden">
      <div class:list={['text-center', CONTAINER]}>
        © 2026 Wzory Dokumentów. Szybko, prosto i legalnie.
      </div>
    </footer>
  </body>
</html>