---
import '../styles/global.css';

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col print:bg-white">
    <header class="navbar bg-base-100 shadow-sm px-4 print:hidden">
      <a href="/" class="text-xl font-bold">Wzory Dokumentów Online</a>
    </header>

    <div class:list={['flex-1 w-full mx-auto px-4 py-8 print:p-0 print:max-w-none', !wide && 'max-w-4xl']}>
      <slot />
    </div>

    <footer class="footer footer-center p-4 bg-base-100 text-sm print:hidden">
      © 2026 Wzory Dokumentów. Szybko, prosto i legalnie.
    </footer>
  </body>
</html>